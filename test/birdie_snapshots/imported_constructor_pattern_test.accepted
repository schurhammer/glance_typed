---
version: 2.0.2
title: imported constructor pattern test
file: ./test/glance_typed_test.gleam
test_name: imported_constructor_pattern_test
---
---
name: example
imports:
- module: "gleam/option"
  unqualified_values:
  - name: Some
  - name: None
functions:
- name: optional_double
  type: "() fn(gleam/option.Option(gleam.Int)) -> gleam/option.Option(gleam.Int)"
  publicity: public
  parameters:
  - type: "gleam/option.Option(gleam.Int)"
    name: maybe
  body:
  - kind: case
    type: "gleam/option.Option(gleam.Int)"
    subjects:
    - kind: local_variable
      type: "gleam/option.Option(gleam.Int)"
      name: maybe
    clauses:
    - patterns:
      -
        - kind: constructor_pattern
          type: "gleam/option.Option(gleam.Int)"
          constructor: Some
          with_spread: false
          positional_arguments:
          - kind: variable_pattern
            type: "gleam.Int"
            name: n
          resolved_module: "gleam/option"
      body:
        kind: call
        type: "gleam/option.Option(gleam.Int){Some}"
        function:
          kind: function
          type: "fn(gleam.Int) -> gleam/option.Option(gleam.Int){Some}"
          module: "gleam/option"
          name: Some
        positional_arguments:
        - kind: binary_operator
          type: "gleam.Int"
          name: "*"
          left:
            kind: int_literal
            type: "gleam.Int"
            value: "2"
          right:
            kind: local_variable
            type: "gleam.Int"
            name: n
    - patterns:
      -
        - kind: constructor_pattern
          type: "gleam/option.Option(gleam.Int)"
          constructor: None
          with_spread: false
          resolved_module: "gleam/option"
      body:
        kind: function
        type: "gleam/option.Option(gleam.Int){None}"
        module: "gleam/option"
        name: None

