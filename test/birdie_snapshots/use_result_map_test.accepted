---
name: example
imports:
- module: "gleam/result"
functions:
- name: example
  type: "() fn(gleam.Result(gleam.Int, gleam.String)) -> gleam.Result(gleam.Int, gleam.String)"
  publicity: public
  parameters:
  - type: "gleam.Result(gleam.Int, gleam.String)"
    name: r
    annotation:
      annotation: "Result(Int, String)"
      type: "gleam.Result(gleam.Int, gleam.String)"
  return:
    annotation: "Result(Int, String)"
    type: "gleam.Result(gleam.Int, gleam.String)"
  body:
  - kind: use
    type: "gleam.Result(gleam.Int, gleam.String)"
    patterns:
    - pattern:
        kind: variable_pattern
        type: "gleam.Int"
        name: x
    function:
      kind: function
      type: "fn(gleam.Result(gleam.Int, gleam.String), fn(gleam.Int) -> gleam.Int) -> gleam.Result(gleam.Int, gleam.String)"
      module: "gleam/result"
      name: map
    arguments:
    - value:
        kind: local_variable
        type: "gleam.Result(gleam.Int, gleam.String)"
        name: r
    body:
    - kind: binary_operator
      type: "gleam.Int"
      name: "+"
      left:
        kind: local_variable
        type: "gleam.Int"
        name: x
      right:
        kind: int_literal
        type: "gleam.Int"
        value: "1"

