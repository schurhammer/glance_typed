---
version: 2.0.2
title: multi subject alternatives narrowing test
file: ./test/glance_typed_test.gleam
test_name: multi_subject_alternatives_narrowing_test
---
---
name: test
types:
- name: Shape
  type: "() test.Shape"
  publicity: public
  opaque: false
  variants:
  - name: Circle
    type: "() fn(gleam.Float) -> test.Shape"
    fields:
    - label: radius
      annotation:
        annotation: Float
        type: "gleam.Float"
  - name: Rect
    type: "() fn(gleam.Float, gleam.Float) -> test.Shape"
    fields:
    - label: width
      annotation:
        annotation: Float
        type: "gleam.Float"
    - label: height
      annotation:
        annotation: Float
        type: "gleam.Float"
functions:
- name: g
  type: "() fn(test.Shape, test.Shape) -> gleam.Float"
  publicity: public
  parameters:
  - type: "test.Shape"
    name: a
    annotation:
      annotation: Shape
      type: "test.Shape"
  - type: "test.Shape"
    name: b
    annotation:
      annotation: Shape
      type: "test.Shape"
  return:
    annotation: Float
    type: "gleam.Float"
  body:
  - kind: case
    type: "gleam.Float"
    subjects:
    - kind: local_variable
      type: "test.Shape"
      name: a
    - kind: local_variable
      type: "test.Shape"
      name: b
    clauses:
    - patterns:
      -
        - kind: constructor_pattern
          type: "test.Shape"
          constructor: Circle
          with_spread: true
          positional_arguments:
          - unmatched: "gleam.Float"
          resolved_module: test
        - kind: constructor_pattern
          type: "test.Shape"
          constructor: Circle
          with_spread: true
          positional_arguments:
          - unmatched: "gleam.Float"
          resolved_module: test
      -
        - kind: constructor_pattern
          type: "test.Shape"
          constructor: Circle
          with_spread: true
          positional_arguments:
          - unmatched: "gleam.Float"
          resolved_module: test
        - kind: constructor_pattern
          type: "test.Shape"
          constructor: Rect
          with_spread: true
          positional_arguments:
          - unmatched: "gleam.Float"
          - unmatched: "gleam.Float"
          resolved_module: test
      body:
        kind: field_access
        type: "gleam.Float"
        container:
          kind: local_variable
          type: "test.Shape{Circle}"
          name: a
        label: radius
        index: 0
    - patterns:
      -
        - kind: constructor_pattern
          type: "test.Shape"
          constructor: Rect
          with_spread: true
          positional_arguments:
          - unmatched: "gleam.Float"
          - unmatched: "gleam.Float"
          resolved_module: test
        - kind: discard_pattern
          type: "test.Shape"
      body:
        kind: field_access
        type: "gleam.Float"
        container:
          kind: local_variable
          type: "test.Shape{Rect}"
          name: a
        label: width
        index: 0

