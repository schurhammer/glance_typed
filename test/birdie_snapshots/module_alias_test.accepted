---
version: 2.0.2
title: module alias test
file: ./test/glance_typed_test.gleam
test_name: module_alias_test
---
---
name: example
imports:
- module: "gleam/option"
  alias: opt
functions:
- name: wrap
  type: "() fn(gleam.Int) -> gleam/option.Option(gleam.Int){Some}"
  publicity: public
  parameters:
  - type: "gleam.Int"
    name: x
    annotation:
      annotation: Int
      type: "gleam.Int"
  body:
  - kind: call
    type: "gleam/option.Option(gleam.Int){Some}"
    function:
      kind: function
      type: "fn(gleam.Int) -> gleam/option.Option(gleam.Int){Some}"
      module: "gleam/option"
      name: Some
    positional_arguments:
    - kind: local_variable
      type: "gleam.Int"
      name: x

