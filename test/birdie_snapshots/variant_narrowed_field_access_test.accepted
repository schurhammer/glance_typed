---
version: 2.0.2
title: variant narrowed field access test
file: ./test/glance_typed_test.gleam
test_name: variant_narrowed_field_access_test
---
---
name: test
types:
- name: Shape
  type: "() test.Shape"
  publicity: public
  opaque: false
  variants:
  - name: Circle
    type: "() fn(gleam.Float) -> test.Shape"
    fields:
    - label: radius
      annotation:
        annotation: Float
        type: "gleam.Float"
  - name: Rect
    type: "() fn(gleam.Float, gleam.Float) -> test.Shape"
    fields:
    - label: width
      annotation:
        annotation: Float
        type: "gleam.Float"
    - label: height
      annotation:
        annotation: Float
        type: "gleam.Float"
functions:
- name: area
  type: "() fn(test.Shape) -> gleam.Float"
  publicity: public
  parameters:
  - type: "test.Shape"
    name: shape
    annotation:
      annotation: Shape
      type: "test.Shape"
  return:
    annotation: Float
    type: "gleam.Float"
  body:
  - kind: case
    type: "gleam.Float"
    subjects:
    - kind: local_variable
      type: "test.Shape"
      name: shape
    clauses:
    - patterns:
      -
        - kind: assignment_pattern
          type: "test.Shape"
          name: c
          pattern:
            kind: constructor_pattern
            type: "test.Shape"
            constructor: Circle
            with_spread: true
            positional_arguments:
            - unmatched: "gleam.Float"
            resolved_module: test
      body:
        kind: binary_operator
        type: "gleam.Float"
        name: "*."
        left:
          kind: binary_operator
          type: "gleam.Float"
          name: "*."
          left:
            kind: float_literal
            type: "gleam.Float"
            value: "3.14"
          right:
            kind: field_access
            type: "gleam.Float"
            container:
              kind: local_variable
              type: "test.Shape{Circle}"
              name: c
            label: radius
            index: 0
        right:
          kind: field_access
          type: "gleam.Float"
          container:
            kind: local_variable
            type: "test.Shape{Circle}"
            name: c
          label: radius
          index: 0
    - patterns:
      -
        - kind: assignment_pattern
          type: "test.Shape"
          name: r
          pattern:
            kind: constructor_pattern
            type: "test.Shape"
            constructor: Rect
            with_spread: true
            positional_arguments:
            - unmatched: "gleam.Float"
            - unmatched: "gleam.Float"
            resolved_module: test
      body:
        kind: binary_operator
        type: "gleam.Float"
        name: "*."
        left:
          kind: field_access
          type: "gleam.Float"
          container:
            kind: local_variable
            type: "test.Shape{Rect}"
            name: r
          label: width
          index: 0
        right:
          kind: field_access
          type: "gleam.Float"
          container:
            kind: local_variable
            type: "test.Shape{Rect}"
            name: r
          label: height
          index: 1

